diff --git a/tests/playwright-test/fixture-teardown-expected-failure-cleanup.spec.ts b/tests/playwright-test/fixture-teardown-expected-failure-cleanup.spec.ts
--- a/tests/playwright-test/fixture-teardown-expected-failure-cleanup.spec.ts
+++ b/tests/playwright-test/fixture-teardown-expected-failure-cleanup.spec.ts
@@ -51,3 +51,75 @@ test('should treat fixture cleanup failure as unexpected after an expected body failure', async ({ runInlineTest }) => {
   for (const testResult of reportTest.results)
     expect(testResult.errors.some(error => error.message?.includes('cleanup exploded'))).toBe(true);
 });
+
+test('should keep an expected body failure expected when cleanup succeeds', async ({ runInlineTest }) => {
+  const result = await runInlineTest({
+    'a.spec.ts': `
+      import { test, expect } from '@playwright/test';
+
+      test('expected body failure only', async () => {
+        test.fail();
+        expect(1).toBe(2);
+      });
+    `,
+  }, { retries: 1 });
+
+  expect(result.exitCode).toBe(0);
+  expect(result.passed).toBe(1);
+  const reportTest = result.report.suites[0].specs[0].tests[0];
+  expect(reportTest.results).toHaveLength(1);
+  expect(reportTest.results[0].status).toBe('failed');
+});
+
+test('should treat afterEach failure as unexpected after an expected body failure', async ({ runInlineTest }) => {
+  const result = await runInlineTest({
+    'a.spec.ts': `
+      import { test, expect } from '@playwright/test';
+
+      test.afterEach(async ({}, testInfo) => {
+        console.log('%%after-each-' + testInfo.retry + '-worker-' + testInfo.workerIndex);
+        throw new Error('afterEach exploded');
+      });
+
+      test('expected body failure', async () => {
+        test.fail();
+        expect(1).toBe(2);
+      });
+    `,
+  }, { retries: 1 });
+
+  expect(result.exitCode).toBe(1);
+  expect(result.failed).toBe(1);
+  expect(result.output).toContain('afterEach exploded');
+
+  const markers = result.outputLines.filter(line => line.startsWith('after-each-'));
+  expect(markers).toHaveLength(2);
+  expect(markers[0]).toMatch(/^after-each-0-worker-\d+$/);
+  expect(markers[1]).toMatch(/^after-each-1-worker-\d+$/);
+  expect(new Set(markers.map(line => line.split('-worker-')[1])).size).toBe(2);
+});
